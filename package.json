{
  "name": "dsh-version-status",
  "version": "0.1.5",
  "description": "DSH core version monitor & upgrade helper: sidebar status badge, npm release checker, and one-click update command",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "update-notifier",
    "version-checker",
    "upgrade-helper",
    "status-panel"
  ],
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j2st1n/dsh-version-status.git"
  },
  "homepage": "https://github.com/j2st1n/dsh-version-status#readme",
  "bugs": "https://github.com/j2st1n/dsh-version-status/issues",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node -c src/index.js src/client.js",
    "test": "node test/run-in-process.js && node test/e2e-review.test.js",
    "test:unit": "node test/index.test.js",
    "test:e2e": "node test/e2e-review.test.js"
  }
}
